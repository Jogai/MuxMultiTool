# Maintainer: Jogai <wouter at jogai dot nl>
#
# Generated by .github/workflows/aur.yml from packaging/aur/PKGBUILD.in in
# https://github.com/Jogai/MuxMultiTool; edit the template there, not on the AUR.
pkgname=muxmultitool-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc="Self-hostable ffmpeg GUI for lossless cutting, remuxing and stream selection (desktop app, CEF)"
arch=('x86_64')
url="https://github.com/Jogai/MuxMultiTool"
license=('GPL-3.0-or-later')
depends=(
	'alsa-lib'
	'at-spi2-core'
	'cairo'
	'dbus'
	'expat'
	'ffmpeg>=2:9'
	'glib2'
	'gtk4'
	'libcups'
	'libdrm'
	'libx11'
	'libxcb'
	'libxcomposite'
	'libxdamage'
	'libxext'
	'libxfixes'
	'libxkbcommon'
	'libxrandr'
	'mesa'
	'nspr'
	'nss'
	'pango'
	'xdg-desktop-portal'
)
optdepends=(
	'xdg-desktop-portal-gnome: file dialogs on GNOME'
	'xdg-desktop-portal-kde: file dialogs on KDE Plasma'
	'xdg-desktop-portal-gtk: file dialogs on other desktops'
)
provides=('muxmultitool')
conflicts=('muxmultitool')
# CEF ships its own stripped libraries; stripping them again breaks nothing but gains nothing.
options=('!strip' '!debug')
source=("https://github.com/Jogai/MuxMultiTool/releases/download/v${pkgver}/muxmultitool-${pkgver}-linux-x86_64.tar.zst")
sha256sums=('@SHA256@')

package() {
	# The layout of the app's Debian package: the executable next to libcef.so
	# in /usr/share/MuxMultiTool (found through its $ORIGIN rpath), the frontend
	# where Tauri looks for resources (/usr/lib/MuxMultiTool), ffmpeg and
	# ffprobe from the ffmpeg package in /usr/bin (backend::sidecar_dir).
	cp -a usr "${pkgdir}/"
	install -d "${pkgdir}/usr/bin"
	ln -s /usr/share/MuxMultiTool/muxmultitool-desktop "${pkgdir}/usr/bin/muxmultitool"
}

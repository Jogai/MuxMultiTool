---
source: crates/core/src/gif/command.rs
expression: cmd
---
ffmpeg -ss 0.500 -i /media/in/trailer.webm -t 2.250 -filter_complex '[0:v:0]fps=12,scale=480:200:flags=lanczos,split[a][b];[a]palettegen=max_colors=256[p];[b][p]paletteuse=dither=sierra2_4a:diff_mode=rectangle' -an -sn -dn -loop 0 -f gif /media/out/trailer.gif

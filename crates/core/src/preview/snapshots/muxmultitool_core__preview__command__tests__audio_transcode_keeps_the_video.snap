---
source: crates/core/src/preview/command.rs
expression: cmd
---
ffmpeg -readrate 2 -readrate_initial_burst 20 -ss 0.130935 -i in.mkv -copyts -start_at_zero -map 0:0 -map 0:1 -c:v copy -c:a aac -b:a 128k -ac 2 -f segment -segment_format mpegts -segment_start_number 0 -segment_time_delta 0.001000 -segment_list out/segments.csv -segment_list_type csv -reset_timestamps 0 -segment_times 3.520000,7.000000,9.000000 out/%d.ts

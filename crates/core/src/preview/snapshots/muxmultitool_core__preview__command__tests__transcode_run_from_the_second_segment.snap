---
source: crates/core/src/preview/command.rs
expression: cmd
---
ffmpeg -readrate 2 -readrate_initial_burst 20 -ss 2.000000 -i /media/in/movie.mkv -copyts -start_at_zero -map 0:0 -map 0:2 -c:v libx264 -preset veryfast -crf 23 -profile:v high -level 4.1 -pix_fmt yuv420p -g 1000 -sc_threshold 0 -forced-idr 1 -force_key_frames 'expr:gte(t,n_forced*2.000000)' -vf scale=1920:-2 -c:a aac -b:a 128k -ac 2 -f segment -segment_format mpegts -segment_start_number 1 -segment_time_delta 0.001000 -segment_list /tmp/mmt/s1/run-1/segments.csv -segment_list_type csv -reset_timestamps 0 -segment_times 2.000000,4.000000 /tmp/mmt/s1/run-1/%d.ts

inpoint 2.05
outpoint 5.5
duration 3.5
file '\''file:/media/in/it'\''\'\'''\''s a movie.mkv'\''
inpoint 752.05
outpoint 800
duration 48
' -map 0 -c copy -avoid_negative_ts make_zero '/media/out/it'\''s cut.mkv'

{
	"productName": "MuxMultiTool",
	"identifier": "io.github.muxmultitool.muxmultitool",
	"build": {
		"beforeBuildCommand": "",
		"beforeDevCommand": ""
	},
	"app": {
		"windows": [],
		"withGlobalTauri": false,
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis", "app", "dmg", "deb", "appimage"],
		"license": "GPL-3.0-or-later",
		"publisher": "MuxMultiTool",
		"homepage": "https://github.com/muxmultitool/muxmultitool",
		"category": "Video",
		"shortDescription": "Self-hostable ffmpeg GUI for lossless cutting, remuxing and stream selection",
		"longDescription": "MuxMultiTool cuts, remuxes and selects streams of media files without re-encoding, with ffmpeg and ffprobe bundled.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
		"resources": {
			"../../web/dist/": "web/"
		},
		"linux": {
			"deb": {
				"depends": [
					"libgtk-4-1",
					"libasound2",
					"libatk-bridge2.0-0",
					"libatk1.0-0",
					"libatspi2.0-0",
					"libcairo2",
					"libcups2",
					"libdbus-1-3",
					"libdrm2",
					"libexpat1",
					"libgbm1",
					"libglib2.0-0",
					"libnspr4",
					"libnss3",
					"libpango-1.0-0",
					"libx11-6",
					"libxcb1",
					"libxcomposite1",
					"libxdamage1",
					"libxext6",
					"libxfixes3",
					"libxkbcommon0",
					"libxrandr2"
				]
			}
		},
		"macOS": {
			"minimumSystemVersion": "11.0"
		},
		"windows": {
			"webviewInstallMode": {
				"type": "downloadBootstrapper"
			}
		}
	}
}
